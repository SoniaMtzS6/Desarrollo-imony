# Configuración de Settlements API
# Copiar este archivo a .env y configurar los valores

# Entorno: 'local' para desarrollo, 'production' para producción
# En local, usa 'local'. En un servidor real, usa 'production'.
SETTLEMENTS_ENV=local

# URL de la Lambda en producción (reemplazar con tu URL real de API Gateway)
SETTLEMENTS_LAMBDA_URL=https://your-api-gateway-url.amazonaws.com/prod

# URL del servidor local (normalmente no se cambia)
SETTLEMENTS_LOCAL_URL=http://localhost:3003

# Las siguientes credenciales son utilizadas por el servidor local de settlements.
# Reemplázalas con tus credenciales de prueba de Pomelo.
POMELO_CLIENT_ID=your-client-id
POMELO_CLIENT_SECRET=your-client-secret
POMELO_USERNAME=your-username
POMELO_PASSWORD=your-password 